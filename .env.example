# Copie para .env e preencha. O .env nunca vai para o repositório.

# Onde guardar vídeos e resultados: "local" (pasta saida/) ou "supabase"
ARMAZENAMENTO=local

# Tamanho máximo do vídeo enviado pelo site, em megabytes
TAMANHO_MAXIMO_VIDEO_MB=200

# Supabase (só quando ARMAZENAMENTO=supabase)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# Laudo com LLM: "modelo_fixo" (sem chave) ou "llm"
LAUDO=modelo_fixo
LLM_API_KEY=
